{
  "name": "root",
  "description": "Library for NLU (Natural Language Understanding) done in Node.js",
  "scripts": {
    "build": "turbo run build",
    "coveralls": "jest --coverage && cat ./tests/coverage/lcov.info | coveralls",
    "lint": "oxlint",
    "lintfix": "oxlint --fix",
    "test": "oxlint --fix && TZ='Europe/London' jest --silent --coverage --maxWorkers=4 ."
  },
  "author": {
    "email": "opensource@axa.com",
    "name": "Jesus Seijas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axa-group/nlp.js.git"
  },
  "bugs": {
    "url": "https://github.com/axa-group/nlp.js/issues"
  },
  "homepage": "https://github.com/axa-group/nlp.js#readme",
  "maintainers": [
    {
      "email": "opensource@axa.com",
      "name": "Jesus Seijas"
    },
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com",
      "url": "https://github.com/kibertoad"
    }
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "coveralls": "^3.1.0",
    "https-proxy-agent": "^5.0.0",
    "jest": "^29.3.1",
    "oxlint": "^1.83.0",
    "prettier": "^2.2.1",
    "supertest": "^6.1.3",
    "turbo": "^2.11.2"
  },
  "jest": {
    "verbose": true,
    "testURL": "http://localhost/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/src/**/**.js",
      "!./packages/lang-**/**",
      "!./packages/python-compiler/src/python-executer.js",
      "!./packages/express-api-server/src/public/**/**"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=18"
  }
}
